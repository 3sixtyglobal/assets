{
	"name": "@3sixty/assets",
	"version": "1.0.0",
	"description": "This repository contains the content for assets",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/assets.git"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"packageManager": "pnpm@12.4.1",
	"scripts": {
		"format": "prettier --write .",
		"lint:format": "prettier --config .prettierrc --check .",
		"lint:markdown": "markdownlint-cli2",
		"lint:spell": "cspell ** --no-progress",
		"lint": "concurrently -g -n format,markdown,spell \"pnpm run lint:format\" \"pnpm run lint:markdown\" \"pnpm run lint:spell\"",
		"dist": "echo There is no dist in this package",
		"commitlint": "commitlint --edit",
		"prepare": "node ./scripts/install-hooks.mjs"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"concurrently": "10.0.5",
		"cspell": "9.1.5",
		"markdownlint-cli2": "0.23.3",
		"prettier": "3.6.2"
	},
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"assets"
	],
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/assets/issues"
	},
	"homepage": "https://3sixty.global"
}
