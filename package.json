{
	"name": "@twin.org/assets",
	"version": "1.0.0",
	"description": "This repository contains the content for assets",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-assets.git"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"scripts": {
		"format": "prettier --write .",
		"lint:format": "prettier --config .prettierrc --check .",
		"lint:markdown": "markdownlint **/*.md --ignore **/node_modules/** --ignore **/docs/reference/**",
		"lint:spell": "cspell ** --no-progress",
		"lint": "npm run lint:format && npm run lint:markdown && npm run lint:spell",
		"dist": "echo There is no dist in this package",
		"commitlint": "commitlint --edit",
		"prepare": "husky"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "19.8.1",
		"@commitlint/config-conventional": "19.8.1",
		"cspell": "9.1.5",
		"fast-glob": "3.3.3",
		"husky": "9.1.7",
		"markdownlint-cli": "0.45.0",
		"prettier": "3.6.2"
	},
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"schema"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-assets/issues"
	},
	"homepage": "https://twindev.org"
